{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>sublimelsp/renovate-preset",
    "github>sublimelsp/renovate-preset:automerge-server"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^plugin\\.py$/"
      ],
      "matchStrings": [
        "TAG = \"(?<currentValue>.+?)\""
      ],
      "datasourceTemplate": "github-releases",
      "packageNameTemplate": "rust-lang/rust-analyzer",
      "versioningTemplate": "regex:^(?<major>\\d+)-(?<minor>\\d+)-(?<patch>\\d+)$"
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": [
        "rust-lang/rust-analyzer"
      ],
      "separateMajorMinor": false,
      "commitMessageExtra": "to v{{{prettyNewVersion}}}",
      "description": "Versions are release dates, so a new year isn't a breaking change: automerge every update, not only patch and minor ones.",
      "automerge": true
    }
  ]
}
